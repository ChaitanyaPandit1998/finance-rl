# Copy this file to .env and fill in your values.
# .env is git-ignored and will never be committed.

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Get your token at: https://huggingface.co/settings/tokens (read scope)
HF_TOKEN=hf_your_token_here

# Root directory for all HuggingFace downloads (models + datasets).
# On cloud GPU instances (RunPod, Lambda) /workspace is the persistent volume,
# so downloads survive container restarts and don't need to be re-fetched.
# Leave unset to use the default HuggingFace cache (~/.cache/huggingface).
HF_HOME=/workspace/hf_cache
